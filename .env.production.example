# URL base de NextAuth en producción (debe coincidir con tu dominio)
NEXTAUTH_URL=https://acma.dgmm.gob.hn

# Clave secreta para encriptar las sesiones de NextAuth
# Puedes generar una en Linux/macOS con: openssl rand -base64 32
NEXTAUTH_SECRET=tu_clave_secreta_super_segura_aqui

# URL de conexión para la base de datos PostgreSQL
# Ejemplo: postgresql://usuario:contraseña@localhost:5432/nombre_db?schema=public
DATABASE_URL=postgresql://usuario:contrasena@host:puerto/db_name

# Ruta del sistema de archivos donde se guardarán los archivos subidos (Zarpes, Documentos, etc.)
# En Windows, puede ser algo como: D:\\Digitalacma o C:\\uploads
# En Linux, puede ser algo como: /var/www/uploads o ./uploads
UPLOADS_BASE_PATH=C:\\uploads

# Puerto opcional en el que correrá el servidor Next.js (por defecto es 3000)
PORT=3000
